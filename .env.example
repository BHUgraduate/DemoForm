# Copy to .env — everything has a safe default; Google Sheets sync stays OFF until the three SHEETS values below are set.
PORT=3001
DATA_DIR=./data
DEMO_SEED=true
MAX_AUDIO_MB=50
MAX_ARTWORK_MB=10

# ── Accounts (demo-grade) ───────────────────────────────────────────
# Admin sign-in for /admin. CHANGE THE PASSWORD for anything beyond a local demo.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-demo-123
# Signs session cookies. Leave empty to auto-generate one into DATA_DIR. Set COOKIE_SECURE=true behind HTTPS.
SESSION_SECRET=
COOKIE_SECURE=false
# Show the demo logins on the sign-in page. Set to false for anything real.
SHOW_DEMO_LOGINS=true

# ── Google Sheets control panel (see GOOGLE_SHEETS_SETUP.md) ────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Releases
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the service-account JSON, as ONE line with literal \n sequences, in double quotes.
GOOGLE_SHEETS_PRIVATE_KEY=
# How often the backend reads the sheet. 60000 normally; use 10000 while presenting. Backend-only setting.
GOOGLE_SHEETS_POLL_INTERVAL_MS=60000
# Optional: link shown on the admin "Open Google Sheet" button (defaults to the spreadsheet's /edit URL)
GOOGLE_SHEET_URL=

# Dev/test only: point the real Google client at the local emulator (scripts/fake-sheets.ts) instead of Google.
GOOGLE_SHEETS_EMULATOR_URL=
